# Whitelist: ignore wszystko, potem przepuść tylko tekst/figury pracy.
# Dane VASP (geometrie/, tmp/, sjcm_mgr/, .venv/) zostają na klasterze.
/*
!/.gitignore
!/.gitattributes

# luźne pliki w korzeniu
!/*.md
!/*.pdf
!/*.pptx
~$*

# notes — vault Obsidian
!/01_Knowledge_Base/
/01_Knowledge_Base/.obsidian/plugins/
/01_Knowledge_Base/.obsidian/workspace.json

# papers -> Zotero na PC (baza + storage), nie git

# LaTeX + Origin. Cale 00_Project/hBN (obliczenia + figs) poza repo -> serwer/klaster.
!/00_Project/
/00_Project/*
!/00_Project/LaTeX/
!/00_Project/Origin/

# śmieci Pythona
__pycache__/
*.pyc

# śmieci LaTeX
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# puste repa odstawione na bok
.git.unused-empty-repo/
